{
  "schema_version": 2,
  "database": ".aiutils/aiutils.db",
  "artifact_directory": ".aiutils/artifacts",
  "languages": [
    {
      "name": "python",
      "python": ".venv/bin/python",
      "include": [
        "api/**/*.py"
      ],
      "exclude": [
        "api/db/migrations/**",
        "**/__pycache__/**"
      ],
      "test": {
        "runner": "pytest",
        "command": [
          ".venv/bin/python",
          "-m",
          "pytest"
        ],
        "test_roots": [
          "tests"
        ]
      },
      "coverage": {
        "source": [
          "api"
        ],
        "branch": true,
        "minimum_line_percent": 80
      }
    }
  ],
  "execution": {
    "timeout_seconds": 600,
    "max_output_bytes": 1048576,
    "max_parallel_runs": 1
  },
  "allow_agent_decisions": false
}
