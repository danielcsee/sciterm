# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# node
node_modules/
ui/dist/

# env
.env

# data (large, downloaded)
PMC-ids.csv
papers/

# corpus-pmids.csv is deliberately NOT ignored: 31 lines, and it is the
# re-import list if the datastore volumes are ever lost.


.DS_Store

# terraform
**/.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions,
# so committing it is what makes two machines resolve the same ones.
crash.log

# local AWS CLI helper/configuration
scripts/aws_config.sh

# aiutils runtime state and its downloaded binary. The tool itself lives in
# github.com/danielcsee/aiutils and scripts/aiutils.sh always fetches the
# latest release, so nothing under here is worth committing.
.aiutils/

# The pre-rename ledger. Kept on disk for reference; its schema predates
# aiutils v0.4.0 and nothing reads it any more.
.testledger/
