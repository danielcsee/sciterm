.DS_Store

# terraform
**/.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions,
# so committing it is what makes two machines resolve the same ones.
crash.log

# local AWS CLI helper/configuration
scripts/aws_config.sh

# Testledger runtime state and its downloaded, checksum-pinned binary.
# The tool itself lives in github.com/danielcsee/testledger; testledger.lock
# is committed, the binary it names is not.
.testledger/

# Local builds of the Codex config generator
scripts/claude-to-codex/bin/
scripts/claude-to-codex/claude-to-codex
